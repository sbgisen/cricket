      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="id">1</param>
    </joint>
    <joint name="head_tilt_joint">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.141592653589793</param>
        <param name="max">3.141592653589793</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="id">2</param>
    </joint>
    <transmission name="pan_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <joint name="head_pan_joint" role="head_pan_joint">
        <mechanical_reduction>1</mechanical_reduction>
      </joint>
    </transmission>
    <transmission name="tilt_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <joint name="head_tilt_joint" role="head_tilt_joint">
        <mechanical_reduction>1</mechanical_reduction>
      </joint>
    </transmission>
  </ros2_control>
