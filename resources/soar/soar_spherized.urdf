  <ros2_control name="VirtualJoint" type="system">
    <hardware>
      <plugin>sbgisen_virtual_interface/PlanarJointSystem</plugin>
      <param name="virtual_joint">virtual_joint</param>
      <param name="parent_frame">map</param>
      <param name="child_link">base_footprint</param>
    </hardware>
  </ros2_control>
  <ros2_control name="LeftWheel" type="actuator">
    <hardware>
      <plugin>vesc_hw_interface/VescHwInterface</plugin>
      <param name="port">/dev/ttyVESC_left</param>
      <param name="gear_ratio">0.230769</param>
      <param name="torque_const">1.0</param>
      <param name="num_hall_sensors">3</param>
      <param name="num_rotor_poles">20</param>
      <param name="motor/Kp">0.1</param>
      <param name="motor/Ki">0.1</param>
      <param name="motor/Kd">0.001</param>
      <param name="motor/i_clamp">0.2</param>
      <param name="motor/duty_limiter">1.0</param>
      <param name="motor/antiwindup">true</param>
      <param name="motor/control_rate">50.0</param>
      <param name="motor/enable_smooth_diff">true</param>
      <param name="motor/smooth_diff/max_sample_sec">0.2</param>
      <param name="motor/smooth_diff/max_sample_step">10</param>
      <param name="command_mode">velocity_duty</param>
      <param name="joint_type">continuous</param>
    </hardware>
    <joint name="wheel_left_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <ros2_control name="RightWheel" type="actuator">
    <hardware>
      <plugin>vesc_hw_interface/VescHwInterface</plugin>
      <param name="port">/dev/ttyVESC_right</param>
      <param name="gear_ratio">0.230769</param>
      <param name="torque_const">1.0</param>
      <param name="num_hall_sensors">3</param>
      <param name="num_rotor_poles">20</param>
      <param name="motor/Kp">0.1</param>
      <param name="motor/Ki">0.1</param>
      <param name="motor/Kd">0.001</param>
      <param name="motor/i_clamp">0.2</param>
      <param name="motor/duty_limiter">1.0</param>
      <param name="motor/antiwindup">true</param>
      <param name="motor/control_rate">50.0</param>
      <param name="motor/enable_smooth_diff">true</param>
      <param name="motor/smooth_diff/max_sample_sec">0.2</param>
      <param name="motor/smooth_diff/max_sample_step">10</param>
      <param name="command_mode">velocity_duty</param>
      <param name="joint_type">continuous</param>
    </hardware>
    <joint name="wheel_right_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <ros2_control name="Torso" type="actuator">
    <hardware>
      <plugin>vesc_hw_interface/VescHwInterface</plugin>
      <param name="port">/dev/ttyVESC_torso</param>
      <param name="servo/calibration">true</param>
      <param name="servo/calibration_mode">duty</param>
      <param name="servo/calibration_duty">-0.15</param>
      <param name="servo/calibration_strict_duty">-0.08</param>
      <param name="servo/calibration_position">0.0</param>
      <param name="servo/use_endstop">true</param>
      <param name="servo/endstop_window">1</param>
      <param name="servo/endstop_threshold">0.8</param>
      <param name="servo/endstop_margin">0.01</param>
      <param name="command_mode">position</param>
      <param name="joint_type">prismatic</param>
    </hardware>
    <joint name="torso_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <ros2_control name="Head" type="system">
    <hardware>
      <plugin>dynamixel_hardware/DynamixelHardware</plugin>
      <param name="usb_port">/dev/ttyDynamixel</param>
      <param name="baud_rate">1000000</param>
      <param name="extended_mode">true</param>
    </hardware>
    <joint name="head_pan_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.141592653589793</param>
        <param name="max">3.141592653589793</param>
